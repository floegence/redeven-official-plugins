{
  "schema_version": "redevplugin.repository-index.v1",
  "targets": [
    {
      "ecosystem": "redevplugin",
      "host": "redeven",
      "plugins": [
        {
          "path": "plugins/mind-map",
          "manifest": "manifest.json",
          "release": {
            "tag_template": "mind-map-v{version}",
            "package_asset_template": "mind-map-{version}.redevplugin"
          },
          "slug": "mind-map"
        },
        {
          "path": "plugins/weather",
          "manifest": "manifest.json",
          "release": {
            "tag_template": "weather-v{version}",
            "package_asset_template": "weather-{version}.redevplugin"
          },
          "slug": "weather"
        }
      ]
    }
  ]
}
