{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plugins.redeven.com/schemas/official-catalog.seed.v1.json",
  "title": "Redeven official plugin catalog seed",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "publisher_id", "generated_from", "plugins"],
  "properties": {
    "schema_version": { "const": "redeven.official_plugin_catalog.seed.v1" },
    "publisher_id": { "const": "com.redeven.official" },
    "generated_from": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "source"],
      "properties": {
        "repository": { "const": "redeven-official-plugins" },
        "source": { "const": "plugin_manifests" }
      }
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "plugin_id",
          "publisher_id",
          "presentation",
          "categories",
          "channels",
          "latest"
        ],
        "properties": {
          "plugin_id": { "type": "string", "pattern": "^com\\.redeven\\.official\\." },
          "publisher_id": { "const": "com.redeven.official" },
          "presentation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["default_locale", "locales"],
            "properties": {
              "default_locale": { "type": "string", "minLength": 2 },
              "locales": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["locale", "name", "summary", "description", "highlights", "keywords", "surfaces", "settings"],
                  "properties": {
                    "locale": { "type": "string", "minLength": 2 },
                    "name": { "type": "string", "minLength": 1 },
                    "publisher_name": { "type": "string", "minLength": 1 },
                    "summary": { "type": "string", "minLength": 1, "maxLength": 240 },
                    "description": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "type": "string", "minLength": 1 } },
                    "highlights": { "type": "array", "maxItems": 8, "items": { "type": "string", "minLength": 1 } },
                    "keywords": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "type": "string", "minLength": 1 } },
                    "surfaces": { "type": "array" },
                    "settings": { "type": "array" }
                  }
                }
              }
            }
          },
          "categories": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "channels": { "type": "array", "minItems": 1, "items": { "enum": ["stable"] } },
          "latest": {
            "type": "object",
            "additionalProperties": false,
            "required": ["version", "min_redeven_version", "min_redevplugin_version", "rollout_state", "default_surface_id", "distribution"],
            "properties": {
              "version": { "type": "string", "minLength": 1 },
              "min_redeven_version": { "type": "string", "minLength": 1 },
              "min_redevplugin_version": { "type": "string", "minLength": 1 },
              "rollout_state": { "enum": ["stable", "staged", "disabled", "revoked"] },
              "default_surface_id": { "type": "string", "minLength": 1 },
              "distribution": {
                "type": "object",
                "additionalProperties": false,
                "required": ["provider", "repository", "tag", "artifact_name", "release_ref_asset_name", "trust_root_asset_name"],
                "properties": {
                  "provider": { "const": "github_release" },
                  "repository": { "const": "floegence/redeven-official-plugins" },
                  "tag": { "type": "string", "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
                  "artifact_name": { "type": "string", "pattern": "\\.redevplugin$" },
                  "release_ref_asset_name": { "type": "string", "pattern": "\\.release-ref\\.json$" },
                  "trust_root_asset_name": { "const": "root.public.json" }
                }
              }
            }
          }
        }
      }
    }
  }
}
