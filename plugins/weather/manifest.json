          "favorites": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "$ref": "#/$defs/location"
            }
          },
          "selected": {
            "anyOf": [
              {
                "$ref": "#/$defs/location"
              },
              {
                "type": "null"
              }
            ]
          },
          "forecast": {
            "anyOf": [
              {
                "$ref": "#/$defs/forecast"
              },
              {
                "type": "null"
              }
            ]
          },
          "location_summaries": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["location_id", "current", "today"],
              "properties": {
                "location_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "current": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "time",
                    "temperature",
                    "apparent_temperature",
                    "humidity",
                    "weather_code",
                    "wind_speed",
                    "is_day"
                  ],
                  "properties": {
                    "time": {
                      "type": "string"
                    },
                    "temperature": {
                      "type": "number"
                    },
                    "apparent_temperature": {
                      "type": "number"
                    },
                    "humidity": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    },
                    "weather_code": {
                      "type": "integer"
                    },
                    "wind_speed": {
                      "type": "number",
                      "minimum": 0
                    },
                    "is_day": {
                      "type": "boolean"
                    }
                  }
                },
                "today": {
                  "anyOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "date",
                        "weather_code",
                        "temperature_max",
                        "temperature_min",
                        "precipitation_probability",
                        "sunrise",
                        "sunset"
                      ],
                      "properties": {
                        "date": {
                          "type": "string"
                        },
                        "weather_code": {
                          "type": "integer"
                        },
                        "temperature_max": {
