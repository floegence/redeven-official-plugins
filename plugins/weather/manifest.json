                    "humidity": {
                      "type": "number"
                    },
                    "wind_speed": {
                      "type": "number"
                    },
                    "wind_direction": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "wind_gusts": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "null"
                        }
