{
  "schema_version": "redevplugin.manifest.v9",
  "publisher": {
    "publisher_id": "com.redeven.official",
    "display_name": "Redeven Official"
  },
  "plugin": {
    "plugin_id": "com.redeven.official.weather",
    "display_name": "Weather",
    "version": "1.0.31"
  },
  "api": {
    "major": 1,
    "required_features": [
      "net.http.v1"
    ],
    "optional_features": []
  },
  "permissions": [
    "network.client"
  ],
  "presentation": {
    "icon": {
      "path": "ui/assets/weather-plugin.png"
    },
    "locales": {
      "default": "en-US"
    }
  },
  "surfaces": [
    {
      "surface_id": "weather.dashboard",
      "kind": "view",
      "intent": "primary",
      "label": "Weather",
      "entry": "ui/index.html",
      "icon": "ui/assets/weather-plugin.png",
      "default_size": {
        "width": 1040,
        "height": 760
      }
    }
  ],
  "workers": [
    {
      "worker_id": "weather_backend",
      "artifact": "workers/weather.wasm",
      "mode": "job",
      "scope": "user",
      "memory_limit_bytes": 33554432
    }
  ],
  "methods": [
    {
      "method": "weather.state.load",
      "effect": "read",
      "execution": "sync",
      "route": {
        "kind": "worker",
        "worker_id": "weather_backend"
      },
      "broker_access": {
        "storage": [
          {
            "store_id": "weather",
            "operations": [
              "get"
            ]
          }
        ]
      },
      "request_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "response_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "favorites",
          "selected",
          "forecast"
        ],
        "properties": {
          "favorites": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "$ref": "#/$defs/location"
            }
          },
          "selected": {
            "anyOf": [
              {
                "$ref": "#/$defs/location"
              },
              {
                "type": "null"
              }
            ]
          },
          "forecast": {
            "anyOf": [
              {
                "$ref": "#/$defs/forecast"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "$defs": {
          "location": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "admin1",
              "country",
              "latitude",
              "longitude",
              "timezone"
            ],
            "properties": {
              "id": { "type": "string", "minLength": 1, "maxLength": 128 },
              "name": { "type": "string", "minLength": 1, "maxLength": 160 },
              "admin1": { "type": "string", "maxLength": 160 },
              "country": { "type": "string", "maxLength": 160 },
              "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
              "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
              "timezone": { "type": "string", "minLength": 1, "maxLength": 120 }
            }
          },
          "forecast": {
            "type": "object",
            "additionalProperties": false,
            "required": ["timezone", "timezone_abbreviation", "source", "current", "days"],
            "properties": {
              "timezone": { "type": "string" },
              "timezone_abbreviation": { "type": "string" },
              "source": { "enum": ["network", "saved"] },
              "current": {
                "type": "object",
                "additionalProperties": false,
                "required": ["time", "temperature", "apparent_temperature", "humidity", "weather_code", "wind_speed", "is_day"],
                "properties": {
                  "time": { "type": "string" },
                  "temperature": { "type": "number" },
                  "apparent_temperature": { "type": "number" },
                  "humidity": { "type": "number", "minimum": 0, "maximum": 100 },
                  "weather_code": { "type": "integer" },
                  "wind_speed": { "type": "number", "minimum": 0 },
                  "is_day": { "type": "boolean" }
                }
              },
              "days": {
                "type": "array",
                "minItems": 1,
                "maxItems": 7,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["date", "weather_code", "temperature_max", "temperature_min", "precipitation_probability", "sunrise", "sunset"],
                  "properties": {
                    "date": { "type": "string" },
                    "weather_code": { "type": "integer" },
                    "temperature_max": { "type": "number" },
                    "temperature_min": { "type": "number" },
                    "precipitation_probability": { "type": "number", "minimum": 0, "maximum": 100 },
                    "sunrise": { "type": "string" },
                    "sunset": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "method": "weather.locations.search",
      "effect": "read",
      "execution": "sync",
      "route": {
        "kind": "worker",
        "worker_id": "weather_backend"
      },
      "broker_access": {
        "network": [
          {
            "connector_id": "geocoding",
            "transport": "http",
            "operations": [
              "http"
            ],
            "http_methods": [
              "GET"
            ]
          }
        ]
      },
      "request_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "query",
          "language"
        ],
        "properties": {
          "query": { "type": "string", "minLength": 2, "maxLength": 120 },
          "language": { "enum": ["en", "zh"] }
        }
      },
      "response_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "locations"
        ],
        "properties": {
          "locations": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "$ref": "#/$defs/location"
            }
          }
        },
        "$defs": {
          "location": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "admin1", "country", "latitude", "longitude", "timezone"],
            "properties": {
              "id": { "type": "string", "minLength": 1, "maxLength": 128 },
              "name": { "type": "string", "minLength": 1, "maxLength": 160 },
              "admin1": { "type": "string", "maxLength": 160 },
              "country": { "type": "string", "maxLength": 160 },
              "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
              "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
              "timezone": { "type": "string", "minLength": 1, "maxLength": 120 }
            }
          }
        }
      }
    },
    {
      "method": "weather.locations.remove",
      "effect": "delete",
      "execution": "sync",
      "route": {
        "kind": "worker",
        "worker_id": "weather_backend"
      },
      "broker_access": {
        "storage": [
          {
            "store_id": "weather",
            "operations": [
              "get",
              "put"
            ]
          }
        ]
      },
      "request_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 128 }
        }
      },
      "response_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["favorites"],
        "properties": {
          "favorites": {
            "type": "array",
            "maxItems": 8,
            "items": { "$ref": "#/$defs/location" }
          }
        },
        "$defs": {
          "location": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "admin1", "country", "latitude", "longitude", "timezone"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "admin1": { "type": "string" },
              "country": { "type": "string" },
              "latitude": { "type": "number" },
              "longitude": { "type": "number" },
              "timezone": { "type": "string" }
            }
          }
        }
      }
    },
    {
      "method": "weather.forecast",
      "effect": "write",
      "execution": "sync",
      "route": {
        "kind": "worker",
        "worker_id": "weather_backend"
      },
      "broker_access": {
        "storage": [
          {
            "store_id": "weather",
            "operations": [
              "get",
              "put"
            ]
          }
        ],
        "network": [
          {
            "connector_id": "forecast",
            "transport": "http",
            "operations": [
              "http"
            ],
            "http_methods": [
              "GET"
            ]
          }
        ]
      },
      "request_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "admin1", "country", "latitude", "longitude", "timezone"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "name": { "type": "string", "minLength": 1, "maxLength": 160 },
          "admin1": { "type": "string", "maxLength": 160 },
          "country": { "type": "string", "maxLength": 160 },
          "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
          "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
          "timezone": { "type": "string", "minLength": 1, "maxLength": 120 }
        }
      },
      "response_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["location", "forecast", "favorites"],
        "properties": {
          "location": { "$ref": "#/$defs/location" },
          "favorites": {
            "type": "array",
            "maxItems": 8,
            "items": { "$ref": "#/$defs/location" }
          },
          "forecast": {
            "type": "object",
            "additionalProperties": false,
            "required": ["timezone", "timezone_abbreviation", "source", "current", "days"],
            "properties": {
              "timezone": { "type": "string" },
              "timezone_abbreviation": { "type": "string" },
              "source": { "enum": ["network", "saved"] },
              "current": {
                "type": "object",
                "additionalProperties": false,
                "required": ["time", "temperature", "apparent_temperature", "humidity", "weather_code", "wind_speed", "is_day"],
                "properties": {
                  "time": { "type": "string" },
                  "temperature": { "type": "number" },
                  "apparent_temperature": { "type": "number" },
                  "humidity": { "type": "number", "minimum": 0, "maximum": 100 },
                  "weather_code": { "type": "integer" },
                  "wind_speed": { "type": "number", "minimum": 0 },
                  "is_day": { "type": "boolean" }
                }
              },
              "days": {
                "type": "array",
                "minItems": 1,
                "maxItems": 7,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["date", "weather_code", "temperature_max", "temperature_min", "precipitation_probability", "sunrise", "sunset"],
                  "properties": {
                    "date": { "type": "string" },
                    "weather_code": { "type": "integer" },
                    "temperature_max": { "type": "number" },
                    "temperature_min": { "type": "number" },
                    "precipitation_probability": { "type": "number", "minimum": 0, "maximum": 100 },
                    "sunrise": { "type": "string" },
                    "sunset": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        "$defs": {
          "location": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "admin1", "country", "latitude", "longitude", "timezone"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "admin1": { "type": "string" },
              "country": { "type": "string" },
              "latitude": { "type": "number" },
              "longitude": { "type": "number" },
              "timezone": { "type": "string" }
            }
          }
        }
      }
    }
  ],
  "storage": {
    "stores": [
      {
        "store_id": "weather",
        "kind": "kv",
        "scope": "user",
        "quota_bytes": 1048576,
        "quota_files": 16,
        "schema_version": 1
      }
    ]
  },
  "network_access": {
    "connectors": [
      {
        "connector_id": "geocoding",
        "transport": "http",
        "scope": "user",
        "destinations": [
          "https://geocoding-api.open-meteo.com"
        ]
      },
      {
        "connector_id": "forecast",
        "transport": "http",
        "scope": "user",
        "destinations": [
          "https://api.open-meteo.com"
        ]
      }
    ]
  }
}
