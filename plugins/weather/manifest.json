                  }
                }
              },
              "hourly": {
                "type": "array",
                "maxItems": 240,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "time",
                    "temperature",
                    "apparent_temperature",
                    "weather_code",
                    "precipitation_probability",
                    "is_day",
                    "humidity",
                    "wind_speed",
                    "wind_direction",
                    "wind_gusts",
                    "pressure",
                    "visibility",
                    "uv_index"
