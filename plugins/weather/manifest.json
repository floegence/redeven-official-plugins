      "effect": "read",
      "execution": "sync",
      "route": {
        "kind": "worker",
        "worker_id": "weather_backend"
      },
      "broker_access": {
        "storage": [
          {
            "store_id": "weather",
            "operations": ["get"]
          }
        ]
      },
      "request_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
