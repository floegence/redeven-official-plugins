                    "temperature": {
                      "type": "number"
                    },
                    "apparent_temperature": {
                      "type": "number"
                    },
                    "weather_code": {
                      "type": "integer"
                    },
                    "precipitation_probability": {
                      "type": "number"
                    },
                    "is_day": {
                      "type": "boolean"
