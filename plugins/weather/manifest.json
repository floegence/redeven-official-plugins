                  "time",
                  "temperature",
                  "apparent_temperature",
                  "humidity",
                  "weather_code",
                  "wind_speed",
                  "is_day"
                ],
                "properties": {
                  "time": {
                    "type": "string"
                  },
                  "temperature": {
                    "type": "number"
                  },
                  "apparent_temperature": {
                    "type": "number"
                  },
                  "humidity": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "weather_code": {
                    "type": "integer"
                  },
                  "wind_speed": {
                    "type": "number",
                    "minimum": 0
                  },
                  "is_day": {
                    "type": "boolean"
                  }
                }
              },
              "days": {
                "type": "array",
                "minItems": 1,
                "maxItems": 10,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "date",
                    "weather_code",
                    "temperature_max",
                    "temperature_min",
                    "precipitation_probability",
                    "sunrise",
                    "sunset"
                  ],
                  "properties": {
                    "date": {
                      "type": "string"
                    },
                    "weather_code": {
                      "type": "integer"
                    },
                    "temperature_max": {
                      "type": "number"
                    },
                    "temperature_min": {
                      "type": "number"
                    },
                    "precipitation_probability": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    },
                    "sunrise": {
                      "type": "string"
                    },
                    "sunset": {
                      "type": "string"
                    },
                    "precipitation_sum": {
                      "anyOf": [
                        {
                          "type": "number",
