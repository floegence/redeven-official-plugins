{
  "schema_version": "redevplugin.manifest.v9",
  "publisher": {
    "publisher_id": "com.redeven.official",
    "display_name": "Redeven Official"
  },
  "plugin": {
    "plugin_id": "com.redeven.official.mind-map",
    "display_name": "Mind Map",
    "version": "1.0.40"
  },
  "api": {
    "major": 1,
    "required_features": [],
    "optional_features": []
  },
  "permissions": [],
  "presentation": {
    "icon": { "path": "ui/assets/mind-map.png" },
    "locales": { "default": "en-US" }
  },
  "surfaces": [
    {
      "surface_id": "mind-map.editor",
      "kind": "view",
      "intent": "primary",
      "label": "Mind Map",
      "entry": "ui/index.html",
      "icon": "ui/assets/mind-map.png",
      "default_size": { "width": 1120, "height": 760 }
    }
  ],
  "workers": [
    {
      "worker_id": "mind_map_backend",
      "artifact": "workers/mind-map.wasm",
      "mode": "job",
      "scope": "user",
      "memory_limit_bytes": 33554432
    }
  ],
  "methods": [
    {
      "method": "mindmap.workspace.load",
      "effect": "write",
      "execution": "sync",
      "route": { "kind": "worker", "worker_id": "mind_map_backend" },
      "broker_access": { "storage": [{ "store_id": "mind-map", "operations": ["get", "put"] }] },
      "request_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "response_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["revision", "saved_at", "workspace_dsl"],
        "properties": {
          "revision": { "type": "integer", "minimum": 0 },
          "saved_at": { "type": ["string", "null"], "maxLength": 64 },
          "workspace_dsl": { "type": "string", "minLength": 1, "maxLength": 3000000 }
        }
      }
    },
    {
      "method": "mindmap.workspace.save",
      "effect": "write",
      "execution": "sync",
      "route": { "kind": "worker", "worker_id": "mind_map_backend" },
      "broker_access": { "storage": [{ "store_id": "mind-map", "operations": ["get", "put"] }] },
      "request_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expected_revision", "workspace_dsl"],
        "properties": {
          "expected_revision": { "type": "integer", "minimum": 0 },
          "workspace_dsl": { "type": "string", "minLength": 1, "maxLength": 3000000 }
        }
      },
      "response_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["revision", "saved_at"],
        "properties": {
          "revision": { "type": "integer", "minimum": 1 },
          "saved_at": { "type": "string", "maxLength": 64 }
        }
      }
    }
  ],
  "storage": {
    "stores": [
      {
        "store_id": "mind-map",
        "kind": "kv",
        "scope": "user",
        "quota_bytes": 4194304,
        "quota_files": 16,
        "schema_version": 1
      }
    ]
  }
}
