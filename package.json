{
  "name": "@floegence/redeven-official-plugins",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check_official_plugins.mjs",
    "catalog:verify": "node scripts/generate_official_catalog.mjs --verify",
    "catalog:write": "node scripts/generate_official_catalog.mjs --write",
    "package:containers": "node scripts/build_official_plugin.mjs containers",
    "verify": "npm test && npm run check && npm run catalog:verify"
  },
  "devDependencies": {}
}
