{
  "name": "@floegence/redeven-official-plugins",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "plugins:ci": "node scripts/run_official_plugins.mjs ci",
    "plugins:audit": "node scripts/run_official_plugins.mjs audit",
    "test": "node --test tests/*.test.mjs && node scripts/run_official_plugins.mjs test",
    "check": "node scripts/check_official_plugins.mjs",
    "catalog:verify": "node scripts/generate_official_catalog.mjs --verify",
    "catalog:write": "node scripts/generate_official_catalog.mjs --write",
    "build:weather": "npm --prefix plugins/weather run build",
    "build:pocket-pounce": "npm --prefix plugins/pocket-pounce run build",
    "package:weather": "npm run build:weather && node scripts/build_official_plugin.mjs weather",
    "package:pocket-pounce": "npm run build:pocket-pounce && node scripts/build_official_plugin.mjs pocket-pounce",
    "release:prepare": "node scripts/release_official_plugin.mjs prepare",
    "release:apply": "node scripts/release_official_plugin.mjs apply",
    "release:finalize": "node scripts/release_official_plugin.mjs finalize",
    "release:verify": "node scripts/release_official_plugin.mjs verify",
    "verify": "npm test && npm run check && npm run catalog:verify"
  },
  "devDependencies": {}
}
